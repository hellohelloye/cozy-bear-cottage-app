# Copy to .env.local for local runs, or set the same names in Vercel/Netlify.
# SERVER-SIDE ONLY — never prefix with VITE_ and never commit a real key.
META_API_KEY=
# Base URL for the Meta Model API, as issued to accepted hackathon participants.
# Fill this in when access arrives with selection (hackathon starts Oct 26, 2026).
META_API_BASE_URL=
# Kids' Artwork upload email (Resend). Get a key at resend.com, set it only
# in Vercel env / .env.local — never commit the real key.
RESEND_API_KEY=
# Optional overrides (defaults shown in api/artwork.js):
ARTWORK_EMAIL_TO=
ARTWORK_EMAIL_FROM=
